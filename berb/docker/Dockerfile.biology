# Berb Biology sandbox — bioinformatics, single-cell analysis.
# Build: docker build -f Dockerfile.biology -t berb/sandbox-biology:latest berb/docker
FROM berb/experiment:base

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# System packages for biology
RUN apt-get update && apt-get install -y --no-install-recommends \
        libhdf5-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Biology packages
RUN pip install \
        scanpy anndata leidenalg \
        biopython

CMD ["python3"]
