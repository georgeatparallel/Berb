# Berb experiment sandbox — base image for domain-specific sandboxes.
# Provides Python 3.11 + common scientific packages + non-root user.
# Domain Dockerfiles should FROM this and add domain packages.
# Build: docker build -f Dockerfile.base -t berb/experiment:base berb/docker/
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel && \
    pip install \
        numpy scipy matplotlib pandas \
        scikit-learn tqdm PyYAML h5py

# Non-root user for security
RUN groupadd -r researcher && useradd -r -g researcher -m -s /bin/bash researcher
WORKDIR /workspace

USER researcher
CMD ["python3"]
