# Berb Math sandbox — discrete math, optimization, graph theory.
# Build: docker build -f Dockerfile.math -t berb/sandbox-math:latest berb/docker
FROM berb/experiment:base

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        gfortran cmake make \
        libopenblas-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install \
        sympy \
        pulp \
        networkx

CMD ["python3"]
