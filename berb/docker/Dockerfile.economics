# Berb Economics sandbox — econometrics, time series, causal inference.
# Build: docker build -f Dockerfile.economics -t berb/sandbox-economics:latest berb/docker
FROM berb/experiment:base

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN pip install \
        statsmodels \
        linearmodels \
        pandas-datareader

CMD ["python3"]
