# Berb Physics sandbox — CPU-focused, numerical computing.
# Build: docker build -f Dockerfile.physics -t berb/sandbox-physics:latest berb/docker
FROM berb/experiment:base

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# System packages for physics
RUN apt-get update && apt-get install -y --no-install-recommends \
        gfortran cmake make \
        libopenblas-dev liblapack-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Physics-specific packages
RUN pip install \
        findiff \
        sympy

# JAX (CPU only for physics sandbox)
RUN pip install \
        jax jaxlib

CMD ["python3"]
