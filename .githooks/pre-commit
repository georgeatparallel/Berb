#!/bin/sh
# Pre-commit hook: block plaintext API keys.
#
# core.hooksPath points here, which means .git/hooks/ is ignored entirely.
# Keep the real logic in this directory, not there.

if command -v python >/dev/null 2>&1; then
    PY=python
else
    PY=python3
fi

# Resolve the scanner next to this script, not relative to the working
# directory: a linked worktree commits with its own root as cwd, and the
# relative path made the hook die with "can't open file" and block the commit.
exec "$PY" "$(dirname "$0")/pre-commit-api-key-scan.py"
